# Copy to .env if needed; never overwrite existing credentials.
# Run make setup-client to generate a local client token; secrets are never printed.
GATEWAY_PORT=8080
# JSON object principal -> token; empty config denies all v0 requests.
CLIENT_TOKENS=
LLM_MODE=replay
LLM_PROVIDER_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini
LLM_API_KEY=
SANDBOX_CPU=1
SANDBOX_MEMORY=256m
SANDBOX_PIDS=64
# Enforced tmpfs size for /work; memory also counts toward SANDBOX_MEMORY.
SANDBOX_DISK=64m
SANDBOX_EXEC_TIMEOUT_S=120
# Harness budgets are configured in configs/pairs/*.json.
