  "$defs": {
    "error": {
      "type": "object",
      "properties": {
        "version": {
          "const": "v0"
        },
        "type": {
          "const": "error"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,80}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "server_epoch": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "error": {
          "$ref": "#/$defs/error_detail"
        }
      },
      "required": [
        "version",
        "type",
        "request_id",
        "server_epoch",
        "error"
      ],
      "additionalProperties": false
    },
    "workdir": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "fixture",
            "mount"
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "mode": {
          "enum": [
            "ro",
            "rw"
          ]
        }
      },
      "required": [
        "kind",
        "source_id",
        "mode"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "tokens_in": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens_out": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tokens_in",
        "tokens_out"
      ],
      "additionalProperties": false
    },
    "run_result": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "timed_out"
          ]
        },
        "answer": {
          "type": "string",
          "maxLength": 65536
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/error_detail"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "mode": {
          "enum": [
            "replay",
            "real"
          ]
        }
      },
      "required": [
        "status",
        "answer",
        "error",
        "usage"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "$ref": "#/$defs/error_detail"
              }
            }
          }
        }
      ]
    },
    "connect": {
      "type": "object",
      "properties": {
        "version": {
          "const": "v0"
        },
        "type": {
          "const": "connect"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "expires_at": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        }
      },
      "required": [
        "version",
        "type",
        "request_id",
        "expires_at",
        "timeout_s"
      ],
      "additionalProperties": false
    },
    "connected": {
      "type": "object",
      "properties": {
        "version": {
          "const": "v0"
        },
        "type": {
          "const": "connected"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "server_epoch": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_timeout_s": {
              "const": 1800
            },
            "request_window_s": {
              "const": 3600
            },
            "event_retention_s": {
              "const": 3600
            },
            "max_events": {
              "const": 10000
            }
          },
          "required": [
            "max_timeout_s",
            "request_window_s",
            "event_retention_s",
            "max_events"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "type",
        "request_id",
        "server_epoch",
        "limits"
      ],
      "additionalProperties": false
    },
