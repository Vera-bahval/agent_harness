      "$ref": "#/$defs/connect"
    },
    {
      "$ref": "#/$defs/connected"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/session.create"
    },
    {
      "$ref": "#/$defs/session.created"
    },
    {
