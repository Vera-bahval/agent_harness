        "run_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "cancelling",
            "terminal"
          ]
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/run_result"
