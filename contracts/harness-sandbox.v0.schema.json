          "type": "object",
          "properties": {
            "name": {
              "const": "WriteFile"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\\\u0000]).+$"
            },
            "content_base64": {
              "type": "string",
              "maxLength": 1398104,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          },
          "required": [
            "name",
            "path",
            "content_base64"
          ],
          "additionalProperties": false
        }
      ]
    },
